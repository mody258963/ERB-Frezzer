		{
			"key": "partId",
			"value": ""
		},
		{
			"key": "categoryId",
			"value": ""
		},
		{
			"key": "customerId",
			"value": ""
		},
		{
			"key": "supplierId",
			"value": ""
		},
		{
			"key": "invoiceId",
			"value": ""
		},
		{
			"key": "transferId",
			"value": ""
		},
		{
			"key": "purchaseId",
			"value": ""
		},
		{
			"key": "installmentId",
			"value": ""
		},
		{
			"key": "settlementId",
			"value": ""
		},
		{
			"key": "returnId",
			"value": ""
		}
