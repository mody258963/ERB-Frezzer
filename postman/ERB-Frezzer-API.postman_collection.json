{
	"info": {
		"_postman_id": "erb-frezzer-api-v1",
		"name": "ERB Frezzer API v1",
		"description": "FrostParts ERP — Laravel Passport (OAuth2).\n\n**Admin (DatabaseSeeder):** `admin@example.com` / `password`\n\n**Option A — API login:** Auth → Login (personal access token)\n**Option B — OAuth2 password grant:** Auth → OAuth Token (password)\n\nDeploy: `php artisan passport:keys --force` and `PassportClientSeeder` before first login.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api/v1"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "oauthUrl",
			"value": "http://127.0.0.1:8000/oauth/token"
		},
		{
			"key": "passwordClientId",
			"value": ""
		},
		{
			"key": "passwordClientSecret",
			"value": ""
		},
		{
			"key": "branchId",
			"value": ""
